{
  "canScale": true,
  "canEditSource": true,
  "gizmo": {
    "title": "Progress donut",
    "description": "A donut chart showing progress toward a total.",
    "icon": "device:data-usage",
    "color": "grey",
    "tags": ["Media", "progress", "chart", "donut", "data"],
    "handles": [],
    "meta": {
      "author": "HAXTheWeb core team"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "title",
        "title": "Title",
        "description": "The title of the element",
        "inputMethod": "textfield",
        "icon": "editor:title"
      },
      {
        "property": "desc",
        "title": "Description",
        "description": "Accessible long description",
        "inputMethod": "textfield"
      },
      {
        "property": "imageSrc",
        "title": "Image Source",
        "description": "Source of image inside donut.",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "noCamera": true,
        "noScreenRecord": true,
        "icon": "link",
        "validationType": "url"
      },
      {
        "property": "imageAlt",
        "title": "Image Alt Text",
        "description": "Alt text for image.",
        "inputMethod": "alt"
      },
      {
        "property": "complete",
        "title": "Complete",
        "description": "An array of completed values.",
        "inputMethod": "array"
      },
      {
        "property": "total",
        "title": "Total",
        "description": "Total when all items are complete.",
        "inputMethod": "number"
      }
    ],
    "advanced": [
      {
        "property": "animated",
        "title": "Animated",
        "description": "Whether progress animates on first load",
        "inputMethod": "boolean"
      },
      {
        "property": "startAngle",
        "title": "Start Angle",
        "description": "Donut angle where progress starts",
        "inputMethod": "number"
      }
    ]
  },
  "demoSchema": [
    {
      "tag": "progress-donut",
      "properties": {
        "title": "Your progress",
        "desc": "You have completed 30 of 50 points: 10 from readings, 8 from quizzes and 12 from projects.",
        "complete": [10, 8, 12],
        "total": 50,
        "animated": true
      },
      "content": ""
    }
  ]
}
