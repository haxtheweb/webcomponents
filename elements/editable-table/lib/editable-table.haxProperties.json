{
  "canScale": false,
  "canEditSource": false,
  "editElement": "editMode",
  "type": "grid",
  "gizmo": {
    "title": "Table",
    "description": "Table-based data for the web.",
    "icon": "editor:border-all",
    "color": "purple",
    "tags": [
      "Content",
      "presentation",
      "table",
      "data",
      "layout",
      "grid",
      "csv",
      "spreadsheet",
      "excel"
    ],
    "handles": [],
    "meta": {
      "author": "HAXTheWeb core team",
      "outlineDesigner": true
    }
  },
  "settings": {
    "configure": [
      {
        "property": "rowHeader",
        "title": "Row Header",
        "description": "Treat first row as a header.",
        "inputMethod": "boolean"
      },
      {
        "property": "columnHeader",
        "title": "Column Header",
        "description": "Treat first column as a header.",
        "inputMethod": "boolean"
      },
      {
        "property": "footer",
        "title": "Footer",
        "description": "Treat last row as a footer.",
        "inputMethod": "boolean"
      },
      {
        "property": "sort",
        "title": "Sortable",
        "description": "Allow sorting by column values.",
        "inputMethod": "boolean"
      },
      {
        "property": "filter",
        "title": "Allow Filter",
        "description": "Allow filtering by column values.",
        "inputMethod": "boolean"
      }
    ],
    "advanced": [
      {
        "property": "bordered",
        "title": "Bordered",
        "inputMethod": "boolean"
      },
      {
        "property": "condensed",
        "title": "Condense Rows",
        "description": "Reduce row height.",
        "inputMethod": "boolean"
      },
      {
        "property": "striped",
        "title": "Striped Rows",
        "description": "Shade every other row.",
        "inputMethod": "boolean"
      },
      {
        "property": "downloadable",
        "title": "Download Button",
        "description": "Add a button to download the table.",
        "inputMethod": "boolean"
      },
      {
        "property": "copyable",
        "title": "Copy Button",
        "description": "Add a button to copy table CSV data.",
        "inputMethod": "boolean"
      },
      {
        "property": "printable",
        "title": "Print Button",
        "description": "Add a button to print only the table.",
        "inputMethod": "boolean"
      },
      {
        "property": "numericStyles",
        "title": "Numeric Styling",
        "description": "Apply numeric styling to numeric columns.",
        "inputMethod": "boolean"
      },
      {
        "property": "responsive",
        "title": "Responsive",
        "description": "Adjust table layout on small screens.",
        "inputMethod": "boolean"
      },
      {
        "property": "rubricMode",
        "title": "Rubric Mode",
        "description": "Interpret this table as an OER Schema Rubric so that Rubric, RubricScale, RubricCriterion, and RubricLevel metadata is emitted.",
        "inputMethod": "boolean"
      },
      {
        "property": "rubricType",
        "title": "Rubric Type",
        "description": "Rubric style emitted as oer:rubricType (only meaningful when Rubric Mode is on).",
        "inputMethod": "select",
        "options": {
          "": "(none)",
          "analytic": "Analytic",
          "holistic": "Holistic",
          "single-point": "Single Point",
          "checklist": "Checklist"
        }
      },
      {
        "property": "dataCsv",
        "title": "Import CSV",
        "description": "Create a table from an uploaded CSV file.",
        "inputMethod": "fileupload",
        "noScreenRecord": true,
        "noVoiceRecord": true,
        "noCamera": true,
        "accepts": "csv"
      }
    ],
    "developer": []
  },
  "saveOptions": {
    "unsetAttributes": ["__utils", "edit-mode", "data", "config", "data-csv"]
  },
  "demoSchema": [
    {
      "tag": "editable-table",
      "properties": {
        "columnHeader": true,
        "bordered": true,
        "striped": true
      },
      "content": "<table><tr><th>Week</th><th>Topic</th><th>Due</th></tr><tr><td>1</td><td>Introduction</td><td>Reading response</td></tr><tr><td>2</td><td>Core concepts</td><td>Quiz 1</td></tr></table>"
    }
  ]
}
