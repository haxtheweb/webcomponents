{
  "canScale": false,
  "designSystem": false,
  "canEditSource": true,
  "gizmo": {
    "title": "Retro card",
    "description": "Simple card with a retro design.",
    "icon": "hax:retro-card",
    "color": "purple",
    "tags": ["Layout", "card"],
    "handles": [],
    "meta": {
      "author": "HAXTheWeb core team",
      "owner": "The Pennsylvania State University"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "title",
        "title": "Title",
        "description": "Main card title.",
        "inputMethod": "textfield",
        "required": false
      },
      {
        "property": "url",
        "description": "URL to open when the card is clicked.",
        "inputMethod": "haxupload",
        "required": false,
        "validationType": "url"
      },
      {
        "property": "subtitle",
        "title": "Sub-title",
        "description": "Card subtitle.",
        "inputMethod": "textfield",
        "required": false
      },
      {
        "property": "tags",
        "title": "Tags",
        "description": "Comma-separated tags.",
        "inputMethod": "textfield",
        "required": false
      },
      {
        "property": "mediaSource",
        "title": "Media source",
        "description": "Primary media source.",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "noCamera": true,
        "noScreenRecord": true,
        "required": true,
        "validationType": "url"
      },
      {
        "property": "hoverSource",
        "description": "Media source shown when the card is hovered or activated.",
        "title": "Source on hover",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "noCamera": true,
        "noScreenRecord": true,
        "required": false,
        "validationType": "url"
      }
    ],
    "advanced": [
      {
        "property": "accentColor",
        "description": "Accent color applied across the card.",
        "title": "Accent Color",
        "inputMethod": "colorpicker",
        "required": false
      }
    ]
  },
  "saveOptions": {
    "unsetAttributes": ["colors"]
  },
  "demoSchema": [
    {
      "tag": "retro-card",
      "properties": {
        "title": "HAX Camp",
        "subtitle": "btopro dreaming reality",
        "tags": "dreams, hax, camp",
        "accentColor": "pink",
        "url": "https://btopro.com",
        "media-source": "https://btopro.com/files/IMG_20190716_102855.jpg"
      },
      "content": ""
    }
  ]
}
