              "kind": "method",
              "name": "_computeIcons",
              "description": "full list of icon names offered (before search filtering)"
            },
            {
              "kind": "field",
              "name": "_matches",
              "description": "icons matching the current search, matched on friendly name or id",
              "readonly": true
            },
            {
              "kind": "field",
              "name": "_rows",
              "description": "the rendered option rows: optional null row followed by matches",
              "readonly": true
            },
