node_modules
# Development-only files: nothing that installs this element loads them,
# so they stay out of the npm package (and the CDNs that mirror it).
/test/
# demos and the root index.html that redirects to them: reviewed on the
# Vercel gallery, never loaded by anything that installs the element
/demo/
/index.html
# the hax.psu.edu landing page (landing/home.html) is deployed to that
# site's web root, never loaded from the package
/landing/
/gulpfile.cjs
/gulpfile.js
/gulpfile.mjs
/rollup.config.js
/web-dev-server.config.mjs
/web-test-runner.config.mjs
/.travis.yml
/.editorconfig
/.surgeignore
