      {
        "property": "name",
        "title": "Name",
        "description": "Name shown on the badge.",
        "inputMethod": "textfield"
      },
      {
        "property": "position",
        "title": "Position",
        "description": "Person's role or title.",
        "inputMethod": "textfield"
      },
      {
        "property": "organization",
        "title": "Organization",
        "description": "Organization the person works for.",
        "inputMethod": "textfield"
      },
      {
        "property": "tvcolor",
        "title": "TV color",
        "description": "Select the color for the TV.",
        "inputMethod": "colorpicker"
      },
      {
        "property": "knobcolor",
        "title": "Knob color",
        "description": "Color of the TV knobs.",
