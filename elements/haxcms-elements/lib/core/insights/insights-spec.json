  "freshness": {
    "editedRecentlyDays": 365,
    "ageBucketsYears": [1, 2, 3, 4],
    "bulkSave": { "minPages": 20, "windowMinutes": 60 },
    "termWords": [
      { "pattern": "\\bsyllabus\\b", "reason": "policies, dates" },
      { "pattern": "\\bschedule\\b", "reason": "dates" },
      { "pattern": "\\bcalendar\\b", "reason": "dates" },
      { "pattern": "\\bexams?\\b", "reason": "exam date" },
      { "pattern": "\\bmidterm\\b", "reason": "exam date" },
      { "pattern": "\\bstaff\\b", "reason": "people" },
      { "pattern": "\\binstructors?\\b", "reason": "people" },
      { "pattern": "\\boffice hours\\b", "reason": "people" },
      { "pattern": "\\bassignments?\\b", "reason": "due dates" },
      { "pattern": "\\bdue dates?\\b", "reason": "due dates" },
      { "pattern": "\\bcourse overview\\b", "reason": "term details" },
      { "pattern": "\\bcanvas\\b", "reason": "tool versions" },
      { "pattern": "\\btechnical issues\\b", "reason": "support contacts" },
      { "pattern": "\\bsemester\\b", "reason": "term details" },
      {
        "pattern": "\\b(fall|spring|summer|winter) \\d{4}\\b",
        "reason": "term details"
      }
    ]
  },
  "metadata": {
    "genericTitles": [
      "page",
      "untitled",
      "new page",
      "untitled page",
      "new item",
      "item"
    ],
    "minSiteDescriptionWords": 5,
    "authorFields": ["image", "description", "socialLink", "socialHandle"],
    "llmsOptional": [
      {
        "id": "searchIndex",
        "label": "Search index",
        "file": "lunrSearchIndex.json"
      },
      { "id": "rss", "label": "RSS", "file": "rss.xml" },
      { "id": "atom", "label": "Atom", "file": "atom.xml" },
      { "id": "sitemap", "label": "Sitemap", "file": "sitemap.xml" },
      {
        "id": "agentSkills",
        "label": "Agent skills",
        "file": ".well-known/agent-skills/index.json"
      }
    ],
    "noJsMinWords": 8,
    "licenses": {
      "by": { "short": "BY", "family": "Creative Commons" },
      "by-sa": { "short": "BY-SA", "family": "Creative Commons" },
      "by-nd": { "short": "BY-ND", "family": "Creative Commons" },
