      "by-nc-sa": { "short": "BY-NC-SA", "family": "Creative Commons" },
      "by-nc-nd": { "short": "BY-NC-ND", "family": "Creative Commons" },
      "cc0": { "short": "CC0", "family": "Public domain" },
      "publicdomain": { "short": "Public domain", "family": "Public domain" },
      "allrightsreserved": {
        "short": "All rights reserved",
        "family": "Copyright"
      }
    }
