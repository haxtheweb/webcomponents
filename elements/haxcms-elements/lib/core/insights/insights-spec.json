  "components": {
    "htmlTags": [
      "p",
      "div",
      "h1",
      "h2",
      "h3",
      "h4",
      "h5",
      "h6",
      "iframe",
      "table"
    ],
    "htmlTagGroups": {
      "h2": "h2–h6",
      "h3": "h2–h6",
      "h4": "h2–h6",
      "h5": "h2–h6",
      "h6": "h2–h6"
    },
    "placeholderTags": ["place-holder"],
    "suggestions": [
      {
        "tag": "self-check",
        "when": "videosWithoutNativeChecks",
        "why": "Quick check after a video; 0 in a course with {videos} videos."
      },
      {
        "tag": "multiple-choice",
        "when": "practiceWithoutPractice",
        "why": "Native practice for the {emptyPractice} “Try it” pages that have none."
      },
      {
        "tag": "a11y-collapse",
        "when": "wallsOfText",
        "why": "Fold worked solutions on long pages like {longestTitle}."
      }
    ]
  },
  "overview": {
    "fixNextLimit": 7,
    "severityOrder": ["error", "warning", "info"]
  },
  "bulkAltSave": { "maxPagesPerHour": 20 },
  "unavailable": {
    "outsideLinkStatus": "Needs server-side link checks",
    "youtubeCaptions": "Needs a server-side YouTube lookup",
    "videoDuration": "Needs a server-side YouTube lookup",
    "bulkAltSave": "Needs a server-side batch save",
    "mediaIndexRebuild": "Needs a server-side rebuild",
    "savedHistory": "Needs scan results stored on the server",
    "schedules": "Needs scheduled scans",
    "editHistory": "Needs the site's git history, readable only on the server",
    "thresholdSettings": "Needs insights settings saved on the server",
    "cli": "Needs a server-side insights provider"
