{
  "version": 1,
  "description": "HAX Insights rules: thresholds and word lists used by insights-analyzer.js. Pure data so a server-side insights provider can load the same file later.",
  "sections": [
    "overview",
    "accessibility",
    "content",
    "links",
    "media",
    "instructional",
    "freshness",
    "metadata",
    "components"
  ],
  "text": {
    "excludeTags": [
      "script",
      "style",
      "template",
      "noscript",
      "lrn-math",
      "math",
      "svg"
    ],
    "wordsPerMinute": 200
  },
  "content": {
    "longPageParagraphs": 5,
    "paragraphsPerHeadingWarn": 8,
    "thinMaxBlocks": 1,
    "thinMaxWords": 40,
    "longestLimit": 6,
    "readTimeBuckets": [1, 2, 3, 4, 5],
    "readability": {
      "minWords": 100,
      "bands": [
        { "max": 6, "label": "Grade 6 or below" },
        { "max": 9, "label": "Grades 7-9" },
        { "max": 12, "label": "Grades 10-12" },
        { "max": 16, "label": "College" },
        { "max": null, "label": "Graduate" }
      ]
    }
  },
  "grouping": {
    "rootLabel": "(root)",
    "rawIdLabel": "(raw IDs)",
    "rawIdPattern": "^item-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "accessibility": {
    "alt": {
      "maxLength": 150,
      "minLength": 5,
      "fileExtensions": ["png", "jpg", "jpeg", "gif", "webp", "svg"],
      "placeholderWords": [
        "image",
        "picture",
        "photo",
        "graphic",
        "img",
        "try it",
        "try it!",
        "click here",
        "untitled",
        "logo",
        "screenshot",
        "placeholder",
        "figure"
      ],
      "mentionWords": ["image", "picture", "photo", "graphic"],
      "equationPattern": "\\b(equation|formula)s?\\b"
    },
    "imageTags": [
      { "tag": "img", "src": "src" },
      { "tag": "media-image", "src": "source" },
      { "tag": "a11y-gif-player", "src": "src" }
    ],
    "contrast": {
      "minRatio": 4.5,
      "dddDefault": { "name": "Beaver blue", "hex": "#1e407c" }
    },
    "mathTags": ["lrn-math"]
  },
  "links": {
    "vagueText": [
      "click here",
      "here",
      "click",
      "read more",
      "more",
      "learn more",
      "link",
      "this link",
      "this",
      "go",
      "website"
    ],
    "trackingParams": [
      "utm_source",
      "utm_medium",
      "utm_campaign",
      "utm_term",
      "utm_content",
      "si",
      "fbclid",
      "gclid",
      "mc_cid",
      "mc_eid",
      "igshid"
    ],
    "fileFolders": ["files", "assets"],
    "slugTitleMinWordLength": 3,
    "homeSlugs": ["", "index", "home"],
    "weekTitlePattern": "\\bweek\\s+(\\d+)\\b",
    "weekSlugPattern": "(?:^|/)week-(\\d+)(?:/|$)",
    "leanOnHostsLimit": 6
  },
  "media": {
    "videoTags": ["video-player", "video"],
    "embedTags": ["iframe"],
    "youtubeHosts": [
      "youtube.com",
      "www.youtube.com",
      "m.youtube.com",
      "youtu.be",
      "www.youtube-nocookie.com",
      "youtube-nocookie.com"
    ],
    "captionTrackKinds": ["captions", "subtitles"],
    "videosPerPageBuckets": [0, 1, 2, 3, 4],
    "noMediaListLimit": 13
  },
  "instructional": {
    "practiceTitlePatterns": ["^\\s*try it\\b"],
    "nativeCheckTags": [
      "self-check",
      "multiple-choice",
      "true-false-question",
      "short-answer-question",
      "fill-in-the-blanks",
      "matching-question",
      "sorting-question",
      "tagging-question",
      "quiz-element",
      "h5p-element",
      "lrn-h5p"
    ],
    "worksheetTags": ["worksheet-download"],
    "textbookTags": ["ebook-button"],
    "guideTags": ["instruction-card"],
    "objectiveContainers": [
      { "tag": "instruction-card" },
      { "tag": "learning-component", "attr": "type", "value": "objectives" }
    ],
    "termGroupPattern": "^week-\\d+$",
    "wallsLimit": 5,
    "activityColumns": [
      { "id": "read", "label": "Read", "source": "paragraphs" },
      { "id": "watch", "label": "Watch", "source": "videos" },
      { "id": "embed", "label": "Embed", "source": "iframes" },
