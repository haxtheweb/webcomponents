    "paragraphsPerHeadingWarn": 8,
    "thinMaxBlocks": 1,
    "thinMaxWords": 40,
    "sectionNoHeadingsParagraphs": 10,
    "noHeadingsWarnPct": 50,
    "longestLimit": 6,
    "readTimeBuckets": [1, 2, 3, 4, 5],
    "readability": {
      "minWords": 100,
      "bands": [
        { "max": 6, "label": "Grade 6 or below" },
        { "max": 9, "label": "Grades 7-9" },
        { "max": 12, "label": "Grades 10-12" },
        { "max": 16, "label": "College" },
        { "max": null, "label": "Graduate" }
      ]
    }
  },
  "grouping": {
    "rootLabel": "(root)",
    "rawIdLabel": "(raw IDs)",
