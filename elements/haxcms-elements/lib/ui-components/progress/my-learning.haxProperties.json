{
  "canScale": false,
  "canEditSource": false,
  "contentEditable": false,
  "gizmo": {
    "title": "My learning",
    "description": "Dashboard of what the visitor has done on this page, section or site.",
    "icon": "social:school",
    "color": "blue",
    "tags": [
      "Instructional",
      "progress",
      "learning",
      "dashboard",
      "xapi",
      "learner"
    ],
    "handles": [],
    "meta": {
      "author": "HAXcms"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "scope",
        "title": "Scope",
        "description": "Which pages it covers, relative to this page",
        "inputMethod": "select",
        "options": {
          "page": "This page",
          "parent": "Parent page and its children",
          "branch": "This branch (parent and everything under it)",
          "children": "All children below this page",
          "site": "Entire site"
        }
      },
      {
        "property": "view",
        "title": "Start in view",
        "description": "How the chart groups activity first",
        "inputMethod": "select",
        "options": {
          "concepts": "Concepts",
          "tags": "Tags",
          "sections": "Sections",
          "activity": "Activity",
          "element": "Element",
          "map": "Map"
        }
      },
      {
        "property": "goal",
        "title": "Goal",
        "description": "Goal ring on the radar, in percent (0 hides it)",
        "inputMethod": "number"
      },
      {
        "property": "tiles",
        "title": "Summary tiles",
        "inputMethod": "boolean"
      },
      {
        "property": "chart",
        "title": "Chart",
        "inputMethod": "boolean"
      },
      {
        "property": "pages",
        "title": "Pages",
        "inputMethod": "boolean"
      },
      {
        "property": "recent",
        "title": "Recent activity",
        "inputMethod": "boolean"
      },
      {
        "property": "preferences",
        "title": "Preferences",
        "inputMethod": "boolean"
      }
    ],
    "advanced": []
  },
  "demoSchema": [
    {
      "tag": "my-learning",
      "properties": {
        "scope": "branch",
        "view": "concepts"
      },
      "content": ""
    }
  ]
}
