{
  "name": "@haxtheweb/chamfer-theme",
  "version": "26.8.1",
  "description": "Fixed-width HAXcms theme with a left navigation column and a chamfered top-left corner on the body area.",
  "license": "Apache-2.0",
  "author": {
    "name": "btopro"
  },
  "keywords": [
    "webcomponents",
    "lit",
    "haxtheweb",
    "haxcms-theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/webcomponents.git"
  },
  "type": "module",
  "main": "chamfer-theme.js",
  "module": "chamfer-theme.js",
  "scripts": {
    "start": "yarn run dev",
    "build": "prettier --ignore-path ../../.prettierignore --write \"**/*.{js,json}\" && cem analyze --litelement --exclude \"(public|*.stories.js)\" --globs \"{*,lib/**}.js\" && node ../../scripts/extract-element-docs.mjs --write .",
    "dev": "concurrently --kill-others \"yarn run watch\" \"yarn run serve\"",
    "watch": "gulp dev --gulpfile=gulpfile.cjs",
    "serve": "web-dev-server -c ../../web-dev-server.config.mjs",
    "lighthouse": "gulp lighthouse --gulpfile=gulpfile.cjs",
    "dddaudit": "hax audit",
    "test:watch": "web-test-runner \"test/**/*.test.js\" --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium --watch",
    "test": "web-test-runner \"test/**/*.test.js\" --coverage --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium"
  },
  "dependencies": {
    "@haxtheweb/d-d-d": "^26.0.0",
    "@haxtheweb/haxcms-elements": "^26.0.0",
    "@haxtheweb/i18n-manager": "^26.8.0",
    "@haxtheweb/scroll-button": "^26.0.0",
    "lit": "3.3.3",
    "mobx": "^6.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@haxtheweb/deduping-fix": "^26.8.0",
    "@open-wc/testing": "4.0.0",
    "@web/dev-server": "0.4.6",
    "concurrently": "9.1.2"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "hax": {
    "cli": true
  },
  "customElements": "custom-elements.json"
}
