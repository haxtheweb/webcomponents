{
  "name": "@haxtheweb/chamfer-theme",
  "version": "26.8.1",
  "description": "Fixed-width HAXcms theme with a left navigation column and a chamfered top-left corner on the body area.",
  "license": "Apache-2.0",
  "author": {
    "name": "btopro"
  },
  "keywords": [
    "webcomponents",
    "lit",
    "haxtheweb",
    "haxcms-theme"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/webcomponents.git"
  },
  "type": "module",
  "main": "chamfer-theme.js",
  "module": "chamfer-theme.js",
  "scripts": {
    "build": "npm run analyze",
    "analyze": "cem analyze --litelement --exclude public",
    "dddaudit": "hax audit",
    "test": "web-test-runner \"test/**/*.test.js\" --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium"
  },
  "dependencies": {
    "lit": "3.3.3",
    "@haxtheweb/d-d-d": "^26.0.0",
    "@haxtheweb/haxcms-elements": "^26.0.0",
    "@haxtheweb/scroll-button": "^26.0.0",
    "mobx": "^6.0.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@haxtheweb/deduping-fix": "^26.0.0",
    "@web/dev-server": "0.4.6",
    "concurrently": "9.1.2"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "hax": {
    "cli": true
  },
  "customElements": "custom-elements.json"
}
