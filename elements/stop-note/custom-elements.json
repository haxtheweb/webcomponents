            {
              "name": "I18NMixin",
              "package": "@haxtheweb/i18n-manager/lib/I18NMixin.js"
            }
          ],
          "superclass": {
            "name": "DDD",
            "package": "@haxtheweb/d-d-d/d-d-d.js"
          },
          "tagName": "stop-note-group",
