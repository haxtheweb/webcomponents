{
  "name": "@haxtheweb/utils",
  "version": "26.8.0",
  "description": "Helper functions to clean up web component data handling.",
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/webcomponents.git"
  },
  "type": "module",
  "main": "utils.js",
  "module": "utils.js",
  "author": {
    "name": "haxtheweb",
    "url": "https://hax.psu.edu/"
  },
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "yarn run dev",
    "build": "prettier --ignore-path ../../.prettierignore --write \"**/*.{js,json}\" && cem analyze --litelement --dev --exclude \"(public|*.stories.js)\" --globs \"{*,lib/**}.js\" && node ../../scripts/extract-element-docs.mjs --write .",
    "dev": "concurrently --kill-others \"yarn run watch\" \"yarn run serve\"",
    "watch": "gulp dev --gulpfile=gulpfile.cjs",
    "serve": "web-dev-server -c ../../web-dev-server.config.mjs",
    "lighthouse": "gulp lighthouse --gulpfile=gulpfile.cjs",
    "test:node": "node --test test/node/safe-html.test.mjs test/node/safe-strings.test.mjs test/node/sanitize-server.test.mjs",
    "test:watch": "web-test-runner \"test/**/*.test.js\" --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium --watch",
    "test": "web-test-runner \"test/**/*.test.js\" --coverage --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium"
  },
  "dependencies": {},
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@open-wc/testing": "4.0.0",
    "@web/dev-server": "0.4.6",
    "@web/test-runner": "^1.0.0"
  },
  "gitHead": "245e0cd5ba8ffa15c755a58abc4f60f74a2f876c",
  "customElements": "custom-elements.json"
}
