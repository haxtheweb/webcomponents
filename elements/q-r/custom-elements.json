  "modules": [
    {
      "kind": "javascript-module",
      "path": "q-r.js",
      "declarations": [
        {
          "kind": "class",
          "description": "`q-r`\n`wrapper for a qr code.`\n\nThe code sits on its own white tile (black on white in either colour\nscheme so phones can scan it) inside a small framed figure, with the\n`title` as a link to `data` under it. The figure is the \"frame\" part and\nthe tile the \"tile\" part, so a surface that already frames it (a theme's\nQR code panel) can drop the frame.",
          "name": "QR",
          "members": [
            {
              "kind": "field",
              "name": "problem",
              "description": "Why no code can be drawn (\"data\", \"format\", \"canvas\"), or null",
              "readonly": true
            },
            {
              "kind": "method",
              "name": "problemText",
              "parameters": [
                {
                  "name": "problem"
                }
              ],
              "description": "The muted note shown instead of a code"
            },
            {
              "kind": "field",
              "name": "altText",
              "description": "Accessible name of the code: \"QR code for {title}\", the data when\nthere is no title",
              "readonly": true
            },
            {
              "kind": "field",
              "name": "safeHref",
              "description": "href for the title link; script and data URLs are never linked",
              "readonly": true
            },
            {
              "kind": "method",
              "name": "_codeError",
              "parameters": [
                {
                  "name": "e"
                }
              ]
            },
            {
              "kind": "field",
              "name": "tag",
              "static": true,
              "readonly": true
            },
            {
              "kind": "field",
              "name": "haxProperties",
              "static": true,
              "description": "Attached to the DOM, now fire.",
              "readonly": true
            },
            {
              "kind": "field",
              "name": "modulesize",
              "privacy": "public",
              "type": {
                "text": "number"
              },
              "description": "module size of the square",
              "default": "4",
              "attribute": "modulesize"
            },
            {
              "kind": "field",
              "name": "margin",
              "privacy": "public",
              "type": {
                "text": "number"
              },
              "description": "Margin on the square",
              "default": "2",
              "attribute": "margin"
            },
            {
              "kind": "field",
              "name": "format",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "format to output",
              "default": "\"png\"",
              "attribute": "format"
            },
            {
              "kind": "field",
              "name": "_error",
              "privacy": "public",
              "type": {
                "text": "null"
              },
              "default": "null",
              "attribute": "_error"
            },
            {
              "kind": "field",
              "name": "t",
              "type": {
                "text": "object"
              },
              "default": "{ qrCodeFor: \"QR code for {title}\", noData: \"No data to show as a QR code\", formatNotSupported: \"QR code format {format} is not supported\", noCanvas: \"This browser can't draw the QR code (no canvas support)\", }"
            },
            {
              "kind": "field",
              "name": "data",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "Data to code via QR code",
              "attribute": "data"
            },
            {
              "kind": "field",
              "name": "title",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "Alternate title for the data",
              "attribute": "title"
            }
          ],
          "attributes": [
            {
              "name": "data",
              "type": {
                "text": "string"
              },
              "description": "Data to code via QR code",
              "fieldName": "data"
            },
            {
