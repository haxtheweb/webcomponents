                "text": "boolean"
              },
              "description": "mode for the slider: wipe",
              "default": "false",
              "attribute": "opacity"
            },
            {
              "kind": "field",
              "name": "fit",
              "privacy": "public",
              "type": {
                "text": "boolean"
              },
              "description": "fill the available height and fit the images without cropping\n(used for full screen)",
              "default": "false",
              "attribute": "fit",
              "reflects": true
