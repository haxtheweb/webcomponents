        {
          "kind": "class",
          "description": "`a11y-compare-image`\nLayers images over each other with a slider interface to compare them.\nOne native range input drives everything: in wipe mode it covers the\nimage (drag the handle, click anywhere, touch or keyboard), in opacity\nmode it sits in the bottom bar between the two image names.\nColours come from DDD. `dark` inverts the slider controls.",
          "name": "a11yCompareImage",
          "members": [
            {
              "kind": "field",
              "name": "_valueText",
              "description": "Spoken value: \"60% City in 2020, 40% Field in 1990\" for two named\nlayers, otherwise just the percent",
              "readonly": true
            },
            {
              "kind": "method",
              "name": "_renderSlider"
            },
            {
              "kind": "method",
              "name": "_renderMarkers"
            },
            {
              "kind": "method",
              "name": "_valueChanged",
              "parameters": [
                {
                  "name": "e"
                }
              ],
              "description": "Range input (or a legacy immediate-value-changed detail) moved"
            },
            {
              "kind": "method",
              "name": "_keydown",
              "parameters": [
                {
                  "name": "e"
                }
              ],
              "description": "Page Up / Page Down move 10, Home / End jump to either end; set here so\nevery browser behaves the same"
            },
            {
              "kind": "field",
              "name": "tag",
              "static": true,
              "readonly": true
            },
            {
              "kind": "method",
              "name": "_slide",
              "description": "updates the slider"
            },
            {
