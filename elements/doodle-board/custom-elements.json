    {
      "kind": "javascript-module",
      "path": "doodle-board.js",
      "declarations": [
        {
          "kind": "class",
          "description": "`doodle-board`\nA drawing on an optional background image. One element covers three\nuses through `mode`:\n\n- draw: a picture made in HAX, or by visitors when `interactive`\n- feedback: marks, highlight zones and comments over a submission\n  (the submission is `src`, the marks are `drawing`)\n- signature: a signature pad\n\nThe marks are a transparent PNG kept apart from the background, so the\nbackground can be swapped without losing them. In HAX the Drawing\nsetting uses the \"doodle\" input method: a preview in the settings\npanel and a dialog with the full editor.",
          "name": "DoodleBoard",
          "members": [
            {
              "kind": "field",
              "name": "tag",
              "static": true,
              "readonly": true
            },
            {
              "kind": "method",
              "name": "_renderCanvas"
            },
            {
              "kind": "method",
              "name": "_renderPicture"
            },
            {
              "kind": "field",
              "name": "mode",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "draw, feedback or signature",
              "default": "\"draw\"",
              "attribute": "mode",
              "reflects": true
            },
            {
              "kind": "field",
              "name": "src",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "background image: a submission to mark up, or a picture to draw on",
              "default": "\"\"",
              "attribute": "src"
            },
            {
              "kind": "field",
              "name": "drawing",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "the marks, a transparent PNG data URL",
              "default": "\"\"",
              "attribute": "drawing"
            },
            {
              "kind": "field",
              "name": "alt",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "description": "describes the drawing and its background for people who cannot see it",
              "default": "\"\"",
              "attribute": "alt"
            },
            {
              "kind": "field",
              "name": "caption",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "attribute": "caption"
            },
            {
              "kind": "field",
              "name": "interactive",
              "privacy": "public",
              "type": {
                "text": "boolean"
              },
              "description": "visitors draw on the published page and can download their picture",
              "default": "false",
              "attribute": "interactive",
