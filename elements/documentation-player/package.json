{
  "name": "@haxtheweb/documentation-player",
  "wcfactory": {
    "className": "DocumentationPlayer",
    "customElementClass": "LitElement",
    "elementName": "documentation-player",
    "generator-wcfactory-version": "0.13.1",
    "useHAX": true,
    "useSass": false,
    "files": {
      "css": "src/documentation-player.css",
      "html": "src/documentation-player.html",
      "js": "src/documentation-player.js",
      "properties": "src/documentation-player-properties.json",
      "hax": "src/documentation-player-hax.json"
    },
    "iconset": {},
    "sharedHaxProps": [],
    "sharedProps": [],
    "sharedStyles": []
  },
  "version": "26.8.0",
  "description": "Living documentation for a web component: animated walkthrough, video tutorial, demo, docs and schema",
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/webcomponents.git"
  },
  "main": "documentation-player.js",
  "module": "documentation-player.js",
  "scripts": {
    "test": "web-test-runner \"test/**/*.test.js\" --node-resolve --config=../../web-test-runner.config.mjs  --playwright --browsers chromium",
    "test:watch": "web-test-runner \"test/**/*.test.js\" --node-resolve --watch --config=../../web-test-runner.config.mjs  --playwright --browsers chromium",
    "start": "yarn run dev",
    "build": "prettier --ignore-path ../../.prettierignore --write '**/*.{js,json}' && cem analyze --litelement --exclude \"(public|*.stories.js)\" --globs \"{*,lib/**}.js\" && node ../../scripts/extract-element-docs.mjs --write .",
    "dev": "concurrently --kill-others \"yarn run watch\" \"yarn run serve\"",
    "watch": "gulp dev --gulpfile=gulpfile.cjs",
    "serve": "web-dev-server -c ../../web-dev-server.config.mjs",
    "lighthouse": "gulp lighthouse --gulpfile=gulpfile.cjs"
  },
  "author": {
    "name": "haxtheweb",
    "url": "https://hax.psu.edu/"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@haxtheweb/d-d-d": "^26.8.0",
    "@haxtheweb/i18n-manager": "^26.8.0",
    "@haxtheweb/utils": "^26.8.0",
    "@haxtheweb/video-player": "^26.8.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@haxtheweb/deduping-fix": "^26.8.0",
    "@open-wc/testing": "4.0.0",
    "@web/dev-server": "0.4.6",
    "concurrently": "9.1.2",
    "gulp-babel": "8.0.0",
    "@haxtheweb/play-list": "^26.8.0",
    "@haxtheweb/demo-snippet": "^26.8.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json",
  "keywords": [
    "webcomponents",
    "html",
    "haxtheweb",
    "lit"
  ],
  "gitHead": "245e0cd5ba8ffa15c755a58abc4f60f74a2f876c"
}
