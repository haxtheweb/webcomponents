{
  "gizmo": {
    "title": "וידאו",
    "description": "השמעת וידאו נגישה ממקורות מרובים."
  },
  "settings": {
    "configure": [
      {
        "property": "source",
        "title": "מקור",
        "description": "כתובת ה-URL של מדיה זו."
      },
      {
        "property": "mediaTitle",
        "title": "כותרת",
        "description": "הכותרת המוצגת מתחת לווידאו."
      },
      {
        "property": "thumbnailSrc",
        "title": "תמונת פוסטר",
        "description": "כתובת URL של תמונת הפוסטר."
      }
    ],
    "advanced": [
      {
        "property": "tracks",
        "title": "רצועות טקסט",
        "description": "כתוביות סגורות, כתוביות תרגום, תיאורים ורצועות טקסט אחרות עבור הווידאו."
      },
      {
        "property": "startTime",
        "title": "זמן התחלה",
        "description": "התחלת הווידאו בזמן מסוים (שניות)."
      },
      {
        "property": "endTime",
        "title": "זמן סיום",
        "description": "סיום הווידאו בזמן מסוים (שניות), נדרש זמן התחלה."
      },
      {
        "property": "learningMode",
        "title": "הפעלת מצב למידה",
        "description": "משבית הרצה קדימה ואחורה."
      },
      {
        "property": "hideYoutubeLink",
        "title": "הסרת הכפתור לפתיחה ב-YouTube",
        "description": "מסיר את הכפתור לפתיחת הווידאו ב-YouTube."
      },
      {
        "property": "linkable",
        "title": "לכלול קישור לשיתוף?",
        "description": "מספק קישור לשיתוף הווידאו."
      },
      {
        "property": "hideTimestamps",
        "title": "הסתרת חותמות זמן",
        "description": "הסתרת חותמות הזמן בתמליל."
      },
      {
        "property": "hideTranscript",
        "title": "הסתרת התמליל",
        "description": "הסתרת התמליל כברירת מחדל."
      },
      {
        "property": "audioDescriptionSource",
        "title": "רצועת תיאור קולי",
        "description": "URL לרצועת תיאור קולי (קובץ MP3) המספקת קריינות של רכיבים חזותיים."
      }
    ],
    "developer": [
      {
        "property": "crossorigin",
        "title": "Crossorigin",
        "description": "מציין אם להשתמש ב-CORS.",
        "options": {
          "anonymous": "anonymous",
          "use-credentials": "use-credentials"
        }
      },
      {
        "property": "allowBackgroundPlay",
        "title": "אפשור השמעה ברקע",
        "description": "המשך ההשמעה כאשר כרטיסיית הדפדפן מאבדת פוקוס."
      },
      {
        "property": "darkTranscript",
        "title": "ערכת נושא כהה לתמליל",
        "description": "הפעלת ערכת נושא כהה לתמליל."
      },
      {
        "property": "disableInteractive",
        "title": "השבתת אינטראקטיביות",
        "description": "השבתת המצב האינטראקטיבי שהופך את התמליל ללחיץ."
      },
      {
        "property": "lang",
        "title": "שפה",
        "description": "שפת המדיה."
      },
      {
        "property": "accentColor",
        "title": "צבע הדגשה",
        "description": "(הוצא משימוש) בחרו את צבע ההדגשה של הנגן."
      }
    ]
  }
}
