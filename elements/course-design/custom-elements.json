      "declarations": [
        {
          "kind": "class",
          "description": "`activity-box`\n`Small styled heading block that sets up an activity`\nA DDD block: the icon is the header chip, the tag is the header title\nunder an \"Activity\" label and the slotted content is the body.\n\nCustom properties (kept from the original element):\n--activity-box-container-padding, --activity-box-container-padding-top,\n--activity-box-container-margin-bottom, --activity-box-content-padding,\n--activity-box-content-font-family, --activity-box-tag-font-weight,\n--activity-box-tag-font-size, --activity-box-icon-left",
          "name": "ActivityBox",
          "members": [
            {
              "kind": "field",
              "name": "tag",
              "privacy": "public",
              "type": {
                "text": "string"
              },
              "static": true,
              "readonly": true,
              "default": "\"\"",
              "attribute": "tag",
              "reflects": true
            },
            {
              "kind": "method",
              "name": "haxHooks",
              "description": "Implements haxHooks to tie into life-cycle if hax exists."
            },
            {
              "kind": "method",
              "name": "haxactiveElementChanged",
              "parameters": [
                {
                  "name": "el"
                },
                {
                  "name": "val"
                }
              ],
              "description": "double-check that we are set to inactivate click handlers\nthis is for when activated in a duplicate / adding new content state\nThe tag is edited in place in the header title."
            },
            {
              "kind": "field",
              "name": "haxProperties",
              "static": true,
              "readonly": true
            },
            {
              "kind": "field",
              "name": "chipIcon",
              "description": "The chip icon: the authored icon, or the activity page type icon",
              "readonly": true
            },
            {
              "kind": "field",
