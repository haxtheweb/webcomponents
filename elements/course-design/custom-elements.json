              "privacy": "public",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "attribute": "icon",
              "reflects": true
            },
            {
              "kind": "field",
              "name": "t",
              "type": {
                "text": "object"
              },
              "default": "{ ...this.t, activity: \"Activity\", }"
            },
            {
              "kind": "field",
              "name": "nocolourize",
              "privacy": "public",
              "type": {
                "text": "boolean"
              },
              "attribute": "nocolourize"
