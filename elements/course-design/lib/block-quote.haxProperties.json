{
  "api": "1",
  "type": "grid",
  "canScale": false,
  "canEditSource": true,
  "hideDefaultSettings": false,
  "designSystem": {
    "accent": true,
    "primary": true,
    "card": true,
    "text": false,
    "designTreatment": false
  },
  "gizmo": {
    "title": "Block quote",
    "description": "Styled quote block.",
    "icon": "editor:format-quote",
    "color": "blue",
    "tags": ["Content", "quote", "blockquote", "design", "presentation"],
    "meta": {
      "author": "HAXTheWeb core team"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "citation",
        "title": "Citation",
        "description": "Citation text.",
        "inputMethod": "textfield"
      },
      {
        "property": "alt",
        "title": "Alt",
        "description": "Alternative text for the image.",
        "inputMethod": "textfield"
      },
      {
        "property": "image",
        "title": "Image",
        "description": "Image shown with the quote.",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "validationType": "url"
      }
    ],
    "advanced": [
      {
        "property": "framed",
        "title": "Framed",
        "description": "Draw the quote on the shared block frame, with an icon and label above it, so it matches notes and instruction cards.",
        "inputMethod": "boolean"
      }
    ]
  },
  "saveOptions": {
    "wipeSlot": false,
    "unsetAttributes": []
  },
  "demoSchema": [
    {
      "tag": "block-quote",
      "properties": {
        "citation": "Ralph Waldo Emerson"
      },
      "content": "<p>The only way to have a friend is to be one.</p>"
    }
  ]
}
