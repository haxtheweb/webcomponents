{
  "api": "1",
  "type": "element",
  "editingElement": "core",
  "hideDefaultSettings": true,
  "canScale": false,
  "canEditSource": true,
  "contentEditable": false,
  "gizmo": {
    "title": "Collection row",
    "description": "Row-style item for use inside a collection list, with text, link, icon, tags, and optional image.",
    "icon": "hax:figure",
    "color": "purple",
    "tags": ["Layout", "collection", "list", "row"],
    "handles": [],
    "meta": {
      "author": "HAXTheWeb core team"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "url",
        "inputMethod": "haxupload",
        "title": "Link",
        "description": "Destination URL for this row.",
        "required": true
      },
      {
        "property": "image",
        "inputMethod": "haxupload",
        "title": "Image",
        "description": "Image for the row.",
        "required": false
      },
      {
        "property": "alt",
        "inputMethod": "alt",
        "title": "Alt",
        "description": "Alternative text describing the image.",
        "required": false
      },
      {
        "property": "line1",
        "inputMethod": "textfield",
        "title": "Line 1",
        "description": "First line of text.",
        "required": true
      },
      {
        "property": "line2",
        "inputMethod": "textfield",
        "title": "Line 2",
        "description": "Second line of text.",
        "required": false
      }
    ],
    "advanced": [
      {
        "property": "icon",
        "inputMethod": "iconpicker",
        "title": "Icon",
        "description": "Icon representing the row.",
        "required": false
      },
      {
        "property": "saturate",
        "inputMethod": "boolean",
        "title": "Saturation effect",
        "description": "Shift image saturation on user focus.",
        "required": false
      },
      {
        "property": "tags",
        "title": "Tags",
        "description": "Comma-separated list of tags.",
        "inputMethod": "textfield",
        "required": true
      },
      {
        "property": "accentColor",
        "title": "Color",
        "description": "Color used for icon and tags.",
        "inputMethod": "colorpicker"
      }
    ],
    "developer": []
  },
  "saveOptions": {
    "unsetAttributes": ["editable"]
  },
  "documentation": {
    "howTo": null,
    "purpose": null
  },
  "demoSchema": [
    {
      "tag": "collection-row",
      "content": "",
      "properties": {
        "line1": "HAX @ PSU",
        "line2": "Write HTML without realizing it",
        "url": "https://hax.psu.edu/",
        "icon": "hax:hax2022",
        "tags": "innovative, sustainable"
      }
    }
  ]
}
