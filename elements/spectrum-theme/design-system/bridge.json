{
  "$comment": "DDD bridge for Adobe Spectrum (Spectrum 2 tokens from @spectrum-css/tokens). Tiers follow elements/d-d-d/design-system/bridge/contract.json. Spectrum's palette is defined per mode (blue-900 is a different color in light and dark), so named DDD colors take the light set as constants (fromMode). Adobe Clean is proprietary and never loaded: type is Source Sans 3 (OFL), the open face Spectrum's own font stack falls back to. Kept as DDD on purpose: state opacities (Spectrum uses state colors), border widths (same values), and heading/body sizes (DDD reading sizes stay).",
  "system": "spectrum",
  "title": "Spectrum",
  "prefix": "Spectrum",
  "homepage": "https://spectrum.adobe.com",
  "sources": [
    {
      "package": "@spectrum-css/tokens",
      "version": "16.0.2",
      "license": "Apache-2.0",
      "copyright": "Copyright 2024 Adobe. All rights reserved.",
      "repository": "https://github.com/adobe/spectrum-css",
      "format": "css",
      "file": "dist/css/index.css",
      "scopes": {
        "light": [".spectrum", ".spectrum--medium", ".spectrum--light"],
        "dark": [".spectrum", ".spectrum--medium", ".spectrum--dark"]
      }
    }
  ],
  "fonts": [
    {
      "family": "Source Sans 3",
      "license": "OFL-1.1",
