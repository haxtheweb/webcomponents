{
  "canScale": false,

  "canEditSource": true,
  "gizmo": {
    "title": "Simple image",
    "description": "An image resized, cropped or rotated by simple settings.",
    "icon": "hax:image-crop",
    "color": "red",
    "tags": ["Media", "image"]
  },
  "settings": {
    "configure": [
      {
        "property": "src",
        "title": "Source",
        "description": "Image source URL.",
        "inputMethod": "haxupload",
        "fileActions": true,
        "noVoiceRecord": true,
        "validationType": "url"
      },
      {
        "property": "height",
        "title": "Height",
        "description": "Optional image height.",
        "inputMethod": "number",
        "min": 0,
        "max": 5000
      },
      {
        "property": "width",
        "title": "Width",
        "description": "Optional image width.",
        "inputMethod": "number",
        "min": 0,
        "max": 5000
      },
      {
        "property": "alt",
        "title": "Alt text",
        "description": "Useful for screen readers and improved SEO.",
        "inputMethod": "alt"
      }
    ],
    "advanced": [],
    "developer": [
      {
        "property": "quality",
        "title": "Quality",
        "description": "Image quality when generating (JPEG only).",
        "inputMethod": "number",
        "min": 0,
        "max": 100
      },
      {
        "property": "fetchpriority",
        "title": "Fetch Priority",
        "description": "Performance hint for modern browsers.",
        "inputMethod": "select",
        "options": {
          "auto": "Automatic",
          "high": "High",
          "low": "Low"
        }
      },
      {
        "property": "decoding",
        "title": "Decoding method",
        "description": "Performance hint for image rendering in modern browsers.",
        "inputMethod": "select",
        "options": {
          "auto": "Automatic",
          "async": "Async"
        }
      }
    ]
  },
  "demoSchema": [
    {
      "tag": "simple-img",
      "properties": {
        "src": "https://placehold.co/600x400",
        "alt": "Placeholder image",
        "width": 600,
        "height": 400
      },
      "content": ""
    }
  ]
}
