{
  "api": "1",
  "canScale": false,
  "canEditSource": true,
  "type": "element",
  "designSystem": {
    "accent": true,
    "primary": false,
    "card": false,
    "text": true,
    "designTreatment": false
  },
  "gizmo": {
    "title": "Side note",
    "description": "A note set apart from the surrounding content, with an optional icon and label.",
    "icon": "icons:bookmark",
    "color": "blue",
    "tags": ["Instructional", "Layout", "Content"],
    "handles": [],
    "meta": {
      "author": "haxtheweb"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "label",
        "title": "Label",
        "description": "The label of the side note.",
        "inputMethod": "textfield",
        "icon": "editor:title"
      },
      {
        "property": "icon",
        "title": "Icon",
        "description": "The icon of the side note.",
        "inputMethod": "iconpicker",
        "options": [
          "icons:announcement",
          "icons:book",
          "icons:bookmark",
          "icons:check-circle",
          "icons:feedback",
          "icons:thumb-down",
          "icons:thumb-up",
          "icons:warning"
        ]
      },
      {
        "slot": "",
        "title": "Content",
        "description": "Content of the side note.",
        "inputMethod": "code-editor"
      }
    ],
    "advanced": [
      {
        "property": "accentColor",
        "title": "Color",
        "description": "The color the side note is tinted with.",
        "inputMethod": "colorpicker",
        "icon": "editor:format-color-fill"
      },
      {
        "property": "dark",
        "title": "Dark",
        "description": "Use the dark theme of the color.",
        "inputMethod": "boolean",
        "icon": "icons:invert-colors"
      }
    ]
  },
  "saveOptions": {
    "wipeSlot": false,
    "unsetAttributes": ["colors"]
  },
  "demoSchema": [
    {
      "tag": "lrndesign-sidenote",
      "properties": {
        "label": "Instructor note",
        "icon": "icons:bookmark"
      },
      "content": "<p>Content goes here. A side note sets supporting information apart from the main text.</p>"
    }
  ]
}
