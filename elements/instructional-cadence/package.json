{
  "name": "@haxtheweb/instructional-cadence",
  "version": "26.8.0",
  "description": "Course pacing as music: one measure per lesson, one beat per page, scored on a five-part lesson shape. For the HAXcms Site Insights dashboard.",
  "license": "Apache-2.0",
  "author": {
    "name": "haxtheweb"
  },
  "keywords": [
    "webcomponents",
    "lit",
    "haxtheweb",
    "haxcms",
    "insights",
    "sheet-music"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/webcomponents/tree/master/elements/instructional-cadence"
  },
  "type": "module",
  "main": "instructional-cadence.js",
  "module": "instructional-cadence.js",
  "scripts": {
    "start": "yarn run dev",
    "build": "prettier --ignore-path ../../.prettierignore --write \"**/*.{js,json}\" && cem analyze --litelement --exclude \"(public|*.stories.js)\" --globs \"{*,lib/**}.js\" && node ../../scripts/extract-element-docs.mjs --write .",
    "dev": "concurrently --kill-others \"yarn run watch\" \"yarn run serve\"",
    "watch": "gulp dev --gulpfile=gulpfile.cjs",
    "serve": "web-dev-server -c ../../web-dev-server.config.mjs",
    "test": "web-test-runner \"test/**/*.test.js\" --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium"
  },
  "dependencies": {
    "lit": "3.3.3",
    "@haxtheweb/d-d-d": "^26.8.0",
    "@haxtheweb/i18n-manager": "^26.8.0",
    "@haxtheweb/sheet-music": "^26.8.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.10.4",
    "@haxtheweb/deduping-fix": "^26.8.0",
    "@web/dev-server": "0.4.6",
    "concurrently": "9.1.2"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "hax": {
    "cli": true
  },
  "customElements": "custom-elements.json"
}
