{
  "gizmo": {
    "description": "Cria um gráfico acessível com base em um CSV."
  },
  "settings": {
    "configure": [
      {
        "property": "accentColor",
        "title": "Cor de destaque",
        "description": "Uma cor de destaque opcional."
      },
      {
        "property": "dark",
        "title": "Tema escuro",
        "description": "Ativar tema escuro"
      },
      {
        "property": "dataSource",
        "title": "Arquivo CSV",
        "description": "Carregar dados de um CSV."
      },
      {
        "slot": "heading",
        "title": "Título do gráfico",
        "description": "Texto alternativo acessível para o seu gráfico."
      },
      {
        "slot": "desc",
        "title": "Descrição do gráfico",
        "description": "Descrição acessível do seu gráfico."
      },
      {
        "property": "scale",
        "title": "Nome da escala",
        "description": "A proporção largura:altura do gráfico (consulte https://gionkunz.github.io/chartist-js/getting-started.html#default-sass-settings para $ct-scales e $ct-scales-names).",
        "options": {
          "ct-square": "ct-square (1:1)",
          "ct-minor-second": "ct-minor-second (15:16)",
          "ct-major-second": "ct-major-second (8:9)",
          "ct-minor-third": "ct-minor-third (5:6)",
          "ct-major-third": "ct-major-third (4:5)",
          "ct-perfect-fourth": "ct-perfect-fourth (3:4)",
          "ct-perfect-fifth": "ct-perfect-fifth (2:3)",
          "ct-minor-sixth": "ct-minor-sixth (5:8)",
          "ct-golden-section": "ct-golden-section (1:1.618)",
          "ct-major-sixth": "ct-major-sixth (3:5)",
          "ct-minor-seventh": "ct-minor-seventh (9:16)",
          "ct-major-seventh": "ct-major-seventh (8:15)",
          "ct-octave": "ct-octave (1:2)",
          "ct-major-tenth": "ct-major-tenth (2:5)",
          "ct-major-eleventh": "ct-major-eleventh (3:8)",
          "ct-major-twelfth": "ct-major-twelfth (1:3)",
          "ct-double-octave": "ct-double-octave (1:4)"
        }
      }
    ],
    "advanced": [
      {
        "property": "reverseData",
        "title": "Inverter dados",
        "description": "Inverte os dados, incluindo os rótulos, a ordem das séries e os arrays de dados de todas as séries."
      },
      {
        "slot": "",
        "title": "Tabela HTML",
        "description": "Opcional: carregar os dados como uma tabela HTML."
      }
    ]
  }
}
