{
  "name": "@haxtheweb/author-card",
  "version": "26.8.0",
  "description": "Webcomponent author-card following hax / open-wc recommendations",
  "license": "Apache-2.0",
  "author": {
    "name": "haxtheweb",
    "url": "https://hax.psu.edu/"
  },
  "keywords": [
    "webcomponents",
    "lit",
    "haxtheweb"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "type": "module",
  "main": "author-card.js",
  "module": "author-card.js",
  "scripts": {
    "start": "yarn run dev",
    "build": "prettier --ignore-path ../../.prettierignore --write \"**/*.{js,json}\" && cem analyze --litelement --exclude \"(public|*.stories.js)\" --globs \"{*,lib/**}.js\" && node ../../scripts/extract-element-docs.mjs --write .",
    "dev": "concurrently --kill-others \"yarn run watch\" \"yarn run serve\"",
    "watch": "gulp dev --gulpfile=gulpfile.cjs",
    "serve": "web-dev-server -c ../../web-dev-server.config.mjs",
    "dddaudit": "hax audit",
    "test:watch": "web-test-runner \"test/**/*.test.js\" --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium --watch",
    "test": "web-test-runner \"test/**/*.test.js\" --coverage --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium"
  },
  "dependencies": {
    "@haxtheweb/d-d-d": "^26.8.0",
    "@haxtheweb/i18n-manager": "^26.8.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@haxtheweb/deduping-fix": "^26.8.0",
    "@open-wc/testing": "4.0.0",
    "@web/dev-server": "0.4.6",
    "concurrently": "9.2.5",
    "@babel/core": "7.29.13",
    "sinon": "17.0.1"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "hax": {
    "cli": true
  },
  "customElements": "custom-elements.json",
  "gitHead": "245e0cd5ba8ffa15c755a58abc4f60f74a2f876c"
}
