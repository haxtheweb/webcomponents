{
  "canScale": true,
  "canEditSource": true,
  "gizmo": {
    "title": "GIF",
    "description": "Make animated GIFs accessible.",
    "icon": "gif",
    "color": "grey",
    "tags": [
      "Media",
      "player",
      "gif",
      "a11y",
      "accessibility",
      "animation",
      "image"
    ],
    "handles": [
      {
        "type": "gif",
        "type_exclusive": true,
        "source": "src",
        "source2": "srcWithoutAnimation",
        "alt": "alt"
      },
      {
        "type": "image",
        "source": "src",
        "source2": "srcWithoutAnimation",
        "alt": "alt"
      }
    ],
    "meta": {
      "author": "HAXTheWeb core team",
      "anchorLabel": "mediaTitle"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "src",
        "title": "Animated GIF",
        "description": "URL for the animated GIF.",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "noScreenRecord": true,
        "noCamera": true,
        "icon": "link",
        "validationType": "url",
        "required": true
      },
      {
        "property": "alt",
        "title": "Alt Text",
        "description": "Alternative text for the image.",
        "inputMethod": "alt",
        "icon": "accessibility",
        "required": true
      },
      {
        "property": "mediaTitle",
        "title": "Title",
        "description": "Title shown above the GIF.",
        "inputMethod": "textfield",
        "validationType": "text"
      },
      {
        "slot": "caption",
        "title": "Caption",
        "description": "Caption shown below the GIF.",
        "inputMethod": "textfield"
      },
      {
        "property": "longdesc",
        "title": "Long Description",
        "description": "Long description of the GIF for accessibility.",
        "inputMethod": "textarea"
      }
    ],
    "advanced": [
      {
        "property": "srcWithoutAnimation",
        "title": "Still Image",
        "description": "URL for a still image version of the GIF.",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "noScreenRecord": true,
        "noCamera": true,
        "fileActions": true,
        "icon": "link",
        "validationType": "url",
        "required": true
      }
    ]
  },
  "saveOptions": {
    "unsetAttributes": [
      "__playing",
      "__gif-loaded",
      "element-visible",
      "t",
      "__has-caption"
    ]
  },
  "demoSchema": [
    {
      "tag": "a11y-gif-player",
      "properties": {
        "alt": "The HAX logo spinning in place",
        "src": "https://cdn.hax.cloud/cdn/build/es6/node_modules/@haxtheweb/a11y-gif-player/lib/hax-logo-spin.gif",
        "srcWithoutAnimation": "https://cdn.hax.cloud/cdn/build/es6/node_modules/@haxtheweb/a11y-gif-player/lib/hax-logo-still.png",
        "longdesc": "The HAX logo, three linked squares holding the letters H, A and X, turns a full circle and repeats.",
        "elementVisible": true,
        "mediaTitle": "Spinning HAX logo"
      },
      "content": "<span slot=\"caption\">The HAX logo, spinning.</span>"
    }
  ]
}
