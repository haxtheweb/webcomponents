{
  "api": "1",
  "canScale": true,
  "canEditSource": true,
  "type": "element",
  "gizmo": {
    "title": "Stat tile",
    "description": "One number that matters, with its label and how it changed. Place several in a grid for a dashboard row.",
    "icon": "editor:insert-chart",
    "color": "blue",
    "tags": ["Content", "data", "number", "stat", "metric", "dashboard", "kpi"],
    "handles": [],
    "meta": {
      "author": "HAXTheWeb core team"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "label",
        "title": "Label",
        "description": "What the number measures.",
        "inputMethod": "textfield",
        "required": true
      },
      {
        "property": "value",
        "title": "Value",
        "description": "The number. A plain number is grouped for the page language; anything else shows as written.",
        "inputMethod": "textfield",
        "required": true
      },
      {
        "property": "change",
        "title": "Change",
        "description": "How it changed, in words, such as 6% this term.",
        "inputMethod": "textfield"
      },
      {
        "property": "trend",
        "title": "Direction",
        "description": "Whether the change is up or down.",
        "inputMethod": "select",
        "options": {
          "": "None",
          "up": "Up",
          "down": "Down"
        }
      }
    ],
    "advanced": [],
    "developer": []
  },
  "saveOptions": {
    "unsetAttributes": ["t"]
  },
  "demoSchema": [
    {
      "tag": "stat-tile",
      "properties": {
        "label": "Enrolled",
        "value": "1284",
        "change": "6% this term",
        "trend": "up"
      },
      "content": ""
    }
  ]
}
