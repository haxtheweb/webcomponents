      "fromMode": "dark",
      "note": "$blue-300 (dark link color)"
    },
    "--ddd-theme-default-skyLight": {
      "token": "--bs-primary-border-subtle",
      "fromMode": "light"
    },
    "--ddd-theme-default-skyMaxLight": {
      "token": "--bs-primary-bg-subtle",
      "fromMode": "light",
      "note": "$blue-100"
    },
