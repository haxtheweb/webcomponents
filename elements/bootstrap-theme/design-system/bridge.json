{
  "$comment": "DDD bridge for Bootstrap 5.3. Tiers follow elements/d-d-d/design-system/bridge/contract.json. Bootstrap writes its CSS variables in :root / [data-bs-theme=light] and [data-bs-theme=dark]; its tint and shade scales ($blue-100 ... $blue-900) only exist in Sass, so named DDD colors use the base colors, the grays and the per-mode subtle and emphasis tokens taken from one mode as constants (fromMode). Bootstrap's sizes are rem, and HAX's root font size is 20px, not 16px, so radii, shadows, control heights and density are written in px with the Bootstrap variable named in the note. Kept as DDD on purpose: state opacities, border widths, heading/body sizes, and enter/exit easing (Bootstrap has one transition easing). Bootstrap's spacers (4, 8, 16, 24, 48px) sit on DDD's 4px grid, so theme chrome uses DDD spacing tokens. Every Bootstrap root variable is exported (extraTokens) so the Bootstrap component CSS the theme chrome adopts in its shadow roots resolves them, in light and dark, through light-dark(); the -rgb channel variables that differ between modes can't be written that way and are left out.",
  "system": "bootstrap",
  "title": "Bootstrap",
  "prefix": "Bootstrap",
  "homepage": "https://getbootstrap.com",
  "sources": [
    {
      "package": "bootstrap",
      "version": "5.3.9",
      "license": "MIT",
      "copyright": "Copyright (c) 2011-2026 The Bootstrap Authors",
      "homepage": "https://getbootstrap.com",
      "repository": "https://github.com/twbs/bootstrap",
      "format": "css",
      "file": "dist/css/bootstrap.css",
      "scopes": {
        "light": [":root"],
        "dark": [":root", "[data-bs-theme=dark]"]
      }
    }
  ],
  "fonts": [],
  "icons": {
    "package": "bootstrap-icons",
    "version": "1.13.2",
    "license": "MIT",
    "path": "icons/{name}.svg",
    "map": "bootstrap-icons"
  },
  "ddd": {
    "--ddd-theme-default-beaverBlue": {
      "token": "--bs-link-hover-color",
      "fromMode": "light",
      "note": "$blue-600: Bootstrap's primary (#0d6efd) is under 4.5:1 as text on the gray-100 and gray-300 surfaces HAX blocks use; the theme chrome keeps --bs-primary"
    },
    "--ddd-theme-default-nittanyNavy": {
      "token": "--bs-primary-text-emphasis",
      "fromMode": "light",
      "note": "$blue-800"
    },
