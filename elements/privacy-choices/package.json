{
  "name": "@haxtheweb/privacy-choices",
  "version": "26.11.0",
  "description": "Lists every third-party service HaxConsent knows with the visitor's choice for each, to change or withdraw at any time.",
  "license": "Apache-2.0",
  "author": {
    "name": "haxtheweb"
  },
  "keywords": [
    "webcomponents",
    "lit",
    "haxtheweb"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/webcomponents.git"
  },
  "type": "module",
  "main": "privacy-choices.js",
  "module": "privacy-choices.js",
  "scripts": {
    "start": "yarn run dev",
    "build": "prettier --ignore-path ../../.prettierignore --write \"**/*.{js,json}\" && cem analyze --litelement --exclude \"(public|*.stories.js)\" --globs \"{*,lib/**}.js\" && node ../../scripts/extract-element-docs.mjs --write .",
    "dev": "concurrently --kill-others \"yarn run watch\" \"yarn run serve\"",
    "watch": "gulp dev --gulpfile=gulpfile.cjs",
    "serve": "web-dev-server -c ../../web-dev-server.config.mjs",
    "test": "web-test-runner \"test/**/*.test.js\" --coverage --node-resolve --config=../../web-test-runner.config.mjs --playwright --browsers chromium"
  },
  "dependencies": {
    "@haxtheweb/d-d-d": "^26.11.0",
    "@haxtheweb/hax-consent-gate": "^26.11.0",
    "@haxtheweb/i18n-manager": "^26.11.0",
    "@haxtheweb/simple-fields": "^26.11.0",
    "@haxtheweb/simple-icon": "^26.11.0",
    "@haxtheweb/utils": "^26.11.0",
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@haxtheweb/deduping-fix": "^26.11.0",
    "@open-wc/testing": "4.0.0",
    "@web/dev-server": "0.4.6",
    "concurrently": "9.2.5",
    "wc-dox": "1.3.5"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json"
}
