            {
              "kind": "method",
              "name": "i18nDefault",
              "parameters": [
                {
                  "name": "prop",
                  "description": "property on this element",
                  "type": {
                    "text": "String"
                  }
                },
                {
                  "name": "key",
                  "description": "this.t key, or (t) => value",
                  "type": {
                    "text": "String|Function"
                  }
                }
              ],
              "description": "Set a property to a translated default and keep it translated.\nTranslations load after the constructor runs, so a value copied\nfrom this.t there would otherwise stay in English. The property\nfollows this.t until something sets it to a different value\n(an attribute, the author, the app), then it is left alone."
            },
            {
              "kind": "method",
              "name": "i18nBind",
              "parameters": [
                {
                  "name": "obj",
                  "type": {
                    "text": "Object"
                  }
                },
                {
                  "name": "field",
                  "type": {
                    "text": "String"
                  }
                },
                {
                  "name": "key",
                  "description": "this.t key, or (t) => value",
                  "type": {
                    "text": "String|Function"
                  }
                },
                {
                  "name": "onChange",
                  "optional": true,
                  "type": {
                    "text": "Function"
                  }
                }
              ],
              "description": "Same as i18nDefault for a field on any object (an option, a program\ndefinition...). onChange(obj) runs after the field is re-translated."
            },
            {
              "kind": "method",
              "name": "_i18nValue",
