    {
      "kind": "javascript-module",
      "path": "lib/LanguageRegistry.js",
      "declarations": [
        {
          "kind": "variable",
          "name": "LANGUAGE_REGISTRY_URL",
          "description": "Helpers for the canonical language registry (`languages.json`).\n\nThe registry is the one list of languages HAX knows about. Anything that\nlets a person pick, store or resolve a language (installer, system\nsettings, site settings, the CLI, the backends) should go through it\ninstead of keeping its own list.\n\nShape of `languages.json`:\n- `languages` is keyed by the canonical code that gets stored (`en`, `sw`,\n  `pt-BR`, `zh-CN`).\n- An entry without `parent` is a language. An entry with `parent` is a\n  regional variant (`en-GB`) that resolves to its parent's translations.\n- `locale` is the translation file suffix (`<namespace>.<locale>.json`),\n  so `zh-CN` stores as `zh-CN` but loads `zh` files.\n- `aliases` are other codes that resolve to the entry (legacy codes like\n  `iw`, script tags like `zh-Hans`).\n- `popular` is an optional rank used to put the most common languages\n  first in short lists.\n\nThis module has no DOM or DDD dependency so the same code can run in a\nbrowser, in Node (inject the parsed JSON with `setLanguageRegistry`) and\nin tests."
        },
        {
          "kind": "function",
          "name": "setLanguageRegistry",
          "parameters": [
            {
              "name": "data",
              "description": "parsed languages.json",
              "type": {
                "text": "Object"
              }
            }
          ]
        },
        {
          "kind": "function",
          "name": "getLanguageRegistry"
        },
        {
          "kind": "function",
          "name": "loadLanguageRegistry",
          "parameters": [
            {
              "name": "url",
              "default": "LANGUAGE_REGISTRY_URL",
              "description": "override for where languages.json lives",
              "type": {
                "text": "String"
              }
            }
          ],
          "return": {
            "type": {
              "text": "Promise<Object>"
            }
          }
        },
        {
          "kind": "function",
          "name": "normalizeLanguageCode",
          "parameters": [
            {
              "name": "value",
              "description": "a language code or locale",
              "type": {
                "text": "String"
              }
            },
            {
              "name": "source",
              "description": "optional raw registry (defaults to the loaded one)",
              "type": {
                "text": "Object"
              }
            }
          ],
          "return": {
            "type": {
              "text": "String|null"
            }
          }
        },
        {
          "kind": "function",
          "name": "matchLanguageCode",
          "parameters": [
            {
              "name": "value",
              "description": "a language code",
              "type": {
                "text": "String"
              }
            },
            {
              "name": "source",
              "description": "optional raw registry (defaults to the loaded one)",
              "type": {
                "text": "Object"
              }
            }
          ],
          "return": {
            "type": {
              "text": "String|null"
            }
          }
        },
        {
          "kind": "function",
          "name": "isSupportedLanguageCode",
          "parameters": [
            {
              "name": "value"
            },
            {
              "name": "source"
            }
          ]
        },
        {
          "kind": "function",
          "name": "getLanguageByCode",
          "parameters": [
            {
              "name": "value"
            },
            {
              "name": "source"
            }
          ],
          "return": {
            "type": {
              "text": "Object|null"
            }
          }
        },
        {
          "kind": "function",
          "name": "getLanguageLocale",
          "parameters": [
            {
              "name": "value"
            },
            {
              "name": "source"
            }
          ],
          "return": {
            "type": {
              "text": "String|null"
            }
          }
        },
        {
          "kind": "function",
          "name": "getLanguageDirection",
          "parameters": [
            {
              "name": "value"
            },
            {
              "name": "source"
            }
          ],
          "return": {
            "type": {
              "text": "\"ltr\"|\"rtl\""
            }
          }
        },
        {
          "kind": "function",
          "name": "getLanguageLabel",
          "parameters": [
            {
              "name": "entry"
            }
          ]
        },
        {
          "kind": "function",
          "name": "getLanguageOptions",
          "parameters": [
            {
              "name": "{\n  includeRegions = \"featured\",\n  popularFirst = false,\n  registry,\n}",
              "default": "{}"
            },
            {
              "name": "config",
              "type": {
                "text": "@param {Boolean|\"featured\"} config.includeRegions regional variants to\n * include: `\"featured\"` (default) only the ones worth choosing separately\n * (en-GB, pt-BR...), `true` all of them, `false` none\n * @param {Boolean} config.popularFirst put ranked languages first, in rank\n * order, then the rest by name\n * @param {Object} config.registry optional raw registry\n * "
              }
            }
          ],
          "return": {
            "type": {
              "text": "Array"
            }
          }
        },
        {
          "kind": "function",
