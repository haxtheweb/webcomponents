{
  "$comment": "DDD bridge for shadcn/ui's default (neutral) theme, layered on Tailwind CSS v4's palette, the same base tailwind-theme uses. Tiers follow elements/d-d-d/design-system/bridge/contract.json. shadcn doesn't publish its theme to npm, so the semantic tokens come from the file `shadcn init` writes, pinned to a commit of the shadcn-ui/ui repo and verified by sha256. Named DDD colors map onto the Tailwind palette; brand roles use neutral, as shadcn's primary does. Kept as DDD on purpose: duration-normal/slow and emphasized easing, state opacities and control heights (no tokens), border widths, and heading/body sizes.",
  "system": "shadcn",
  "title": "shadcn/ui",
  "prefix": "Shadcn",
  "homepage": "https://ui.shadcn.com",
  "sources": [
    {
      "package": "tailwindcss",
      "version": "4.3.5",
      "license": "MIT",
      "copyright": "Copyright (c) Tailwind Labs, Inc.",
      "repository": "https://github.com/tailwindlabs/tailwindcss",
      "format": "css",
      "file": "theme.css",
      "scopes": {
        "light": ["@theme default"],
        "dark": ["@theme default"]
      }
    },
    {
      "url": "https://raw.githubusercontent.com/shadcn-ui/ui/dd41d19e2f80ff6891951f7ced74c2c9a650b065/packages/tests/fixtures/next-app-init/app/globals.css",
      "sha256": "c7531f2a5d181e3c45c941b3e23928a65117611b653a1dd8ed4ca91530b17838",
      "licenseUrl": "https://raw.githubusercontent.com/shadcn-ui/ui/dd41d19e2f80ff6891951f7ced74c2c9a650b065/LICENSE.md",
      "package": "shadcn-ui/ui (theme written by shadcn init)",
      "version": "dd41d19e2f80ff6891951f7ced74c2c9a650b065",
      "license": "MIT",
      "copyright": "Copyright (c) 2023 shadcn",
      "repository": "https://github.com/shadcn-ui/ui",
      "format": "css",
      "scopes": {
        "light": [":root", "@theme inline"],
        "dark": [":root", ".dark", "@theme inline"]
      }
    }
  ],
