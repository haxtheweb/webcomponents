        {
          "kind": "class",
          "description": "`lrn-vocab`\nVocabulary term with visual treatment and semantic meaning.\n\nReads like vocab-term inside a sentence: a dotted underline (solid on\nhover, DDD focus ring) that opens the definition in a large modal headed\nby the same Vocabulary chip and label. `--lrn-vocab-border` still works: its\nwidth, style and colour become the underline's (for example\n`--lrn-vocab-border: 2px dashed red`).",
          "name": "LrnVocab",
          "members": [
            {
              "kind": "field",
              "name": "tag",
              "static": true,
              "readonly": true
            },
            {
              "kind": "method",
              "name": "haxHooks",
              "description": "Implements haxHooks to tie into life-cycle if hax exists."
            },
            {
              "kind": "method",
              "name": "haxactiveElementChanged",
              "parameters": [
                {
                  "name": "el"
                },
                {
                  "name": "val"
                }
              ],
              "description": "double-check that we are set to inactivate click handlers\nthis is for when activated in a duplicate / adding new content state"
            },
            {
              "kind": "method",
              "name": "haxeditModeChanged",
              "parameters": [
                {
                  "name": "val"
                }
              ],
              "description": "Set a flag to test if we should block link clicking on the entire card\notherwise when editing in hax you can't actually edit it bc its all clickable.\nif editMode goes off this helps ensure we also become clickable again"
            },
            {
              "kind": "method",
              "name": "renderLabel",
              "description": "Vocabulary chip and label for the top of the modal (matches vocab-term)"
            },
            {
              "kind": "method",
              "name": "openDialog",
              "parameters": [
                {
                  "name": "e"
                }
              ],
              "description": "Request the singleton dialog open"
            },
            {
              "kind": "field",
              "name": "haxProperties",
              "static": true,
              "readonly": true
            },
            {
              "kind": "field",
              "name": "t",
              "type": {
                "text": "object"
              },
              "default": "{ ...this.t, vocabulary: \"Vocabulary\", }"
