{
  "canScale": true,

  "canEditSource": true,
  "gizmo": {
    "title": "Post card",
    "description": "A playful media piece meant to look like a physical post card from somewhere",
    "icon": "maps:local-post-office",
    "color": "blue",
    "tags": [
      "Other",
      "fun",
      "extra",
      "postcard",
      "card",
      "block",
      "layout",
      "design"
    ]
  },
  "settings": {
    "configure": [
      {
        "property": "to",
        "title": "To",
        "description": "The person the card is addressed to.",
        "inputMethod": "textfield"
      },
      {
        "property": "from",
        "title": "From",
        "description": "Your name, as the sender of the card.",
        "inputMethod": "textfield"
      },
      {
        "property": "message",
        "title": "Message",
        "description": "The note on the back of the card.",
        "inputMethod": "textfield"
      },
      {
        "property": "postMarkLocations",
        "title": "Postmarked From",
        "description": "Places on the postmark, such as Paris - Rome.",
        "inputMethod": "textfield"
      },
      {
        "property": "photoSrc",
        "title": "Main Photo Source",
        "description": "The photo on the front of the card.",
        "inputMethod": "fileupload"
      },
      {
        "property": "stampSrc",
        "title": "Stamp Photo Source",
        "description": "The picture on the stamp.",
        "inputMethod": "fileupload"
      }
    ],
    "advanced": []
  },
  "demoSchema": [
    {
      "tag": "post-card",
      "properties": {
        "to": "A friend",
        "from": "State College",
        "postMarkLocations": "State College",
        "message": "Wish you were here!",
        "photoSrc": "https://placehold.co/600x400",
        "stampSrc": "https://placehold.co/100x120"
      },
      "content": ""
    }
  ]
}
