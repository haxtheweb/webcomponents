{
  "api": "1",
  "type": "element",
  "canScale": false,
  "canEditSource": true,
  "gizmo": {
    "title": "Polaris story card",
    "description": "Display a Polaris story card with a background image, pillar label, and headline text.",
    "icon": "image:photo",
    "color": "blue",
    "tags": ["Layout", "Card", "Theme", "Polaris"],
    "handles": [
      {
        "type": "image",
        "source": "image"
      },
      {
        "type": "text",
        "source": "label"
      },
      {
        "type": "text",
        "source": "pillar"
      },
      {
        "type": "link",
        "source": "link",
        "title": "label"
      }
    ],
    "meta": {
      "author": "HAXTheWeb core team"
    }
  },
  "settings": {
    "configure": [
      {
        "property": "image",
        "title": "Background image",
        "description": "Image URL shown as the card background.",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "noCamera": true,
        "validationType": "url"
      },
      {
        "property": "backgroundSize",
        "title": "Background size",
        "description": "How the background image fills the card (CSS background-size).",
        "inputMethod": "select",
        "options": {
          "cover": "cover",
          "contain": "contain",
          "auto": "auto",
          "100% 100%": "100% 100%"
        }
      },
      {
        "property": "backgroundAttachment",
        "title": "Background attachment",
        "description": "How the background image behaves when scrolling (CSS background-attachment).",
        "inputMethod": "select",
        "options": {
          "scroll": "scroll",
          "fixed": "fixed",
          "local": "local"
        }
      },
      {
        "property": "pillar",
        "title": "Pillar label",
        "description": "Short uppercase label shown at the top of the card. Leave empty to hide.",
        "inputMethod": "textfield"
      },
      {
        "property": "label",
        "title": "Card text",
        "description": "Primary text displayed in the lower panel.",
        "inputMethod": "textfield"
      },
      {
        "property": "link",
        "title": "Link",
        "description": "Optional destination URL that wraps the whole card.",
        "inputMethod": "haxupload",
        "noVoiceRecord": true,
        "noCamera": true,
        "validationType": "url"
      }
    ],
    "advanced": []
  },
  "saveOptions": {
    "unsetAttributes": ["editMode"]
  },
  "demoSchema": [
    {
      "tag": "polaris-story-card",
      "properties": {
        "image": "https://picsum.photos/480/640",
        "pillar": "Accessible",
        "label": "Design for everyone",
        "link": "https://haxtheweb.org/"
      },
      "content": ""
    }
  ]
}
