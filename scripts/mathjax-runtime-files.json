    "@mathjax/mathjax-newcm-font/svg",
    "@mathjax/mathjax-bbm-font-extension/package.json",
    "@mathjax/mathjax-bbm-font-extension/svg.js",
    "@mathjax/mathjax-bboldx-font-extension/package.json",
    "@mathjax/mathjax-bboldx-font-extension/svg.js",
    "@mathjax/mathjax-dsfont-font-extension/package.json",
