{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://haxtheweb.org/xapi/schema/statement-1.0.3.json",
  "title": "xAPI 1.0.3 Statement",
  "description": "Statement rules of xAPI 1.0.3 (https://github.com/adlnet/xAPI-Spec/blob/1.0.3/xAPI-Data.md#statements) as JSON Schema draft-07. Rules JSON Schema can not express (response and correctResponsesPattern grammar against the interaction components, score raw within min and max) are checked by scripts/lib/xapi-conformance.mjs.",
  "type": "object",
  "required": ["actor", "verb", "object"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "#/definitions/uuid"
    },
    "actor": {
      "$ref": "#/definitions/actor"
    },
    "verb": {
      "$ref": "#/definitions/verb"
    },
    "object": {
      "$ref": "#/definitions/object"
    },
    "result": {
      "$ref": "#/definitions/result"
    },
    "context": {
      "$ref": "#/definitions/context"
    },
    "timestamp": {
      "$ref": "#/definitions/timestamp"
    },
    "stored": {
      "$ref": "#/definitions/timestamp"
    },
    "authority": {
      "$ref": "#/definitions/actor"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.0(\\.[0-9]+)?$"
    },
    "attachments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/attachment"
      }
    }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "iri": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:[^\\s]+$"
    },
    "mbox": {
      "type": "string",
      "pattern": "^mailto:[^\\s@]+@[^\\s@]+$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "languageTag": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,8}(-[a-zA-Z0-9]{1,8})*$"
    },
    "languageMap": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/languageTag"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/iri"
      }
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):?[0-5][0-9])$"
    },
    "duration": {
      "type": "string",
      "pattern": "^P(?!$)([0-9]+(\\.[0-9]+)?Y)?([0-9]+(\\.[0-9]+)?M)?([0-9]+(\\.[0-9]+)?W)?([0-9]+(\\.[0-9]+)?D)?(T(?=[0-9])([0-9]+(\\.[0-9]+)?H)?([0-9]+(\\.[0-9]+)?M)?([0-9]+(\\.[0-9]+)?S)?)?$"
    },
    "account": {
      "type": "object",
      "required": ["homePage", "name"],
      "additionalProperties": false,
      "properties": {
        "homePage": {
          "$ref": "#/definitions/iri"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ifi": {
      "oneOf": [
        {
          "required": ["mbox"]
        },
        {
          "required": ["mbox_sha1sum"]
        },
        {
          "required": ["openid"]
        },
        {
          "required": ["account"]
        }
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/definitions/ifi"
        }
      ],
      "properties": {
        "objectType": {
          "const": "Agent"
        },
        "name": {
          "type": "string"
        },
        "mbox": {
          "$ref": "#/definitions/mbox"
        },
        "mbox_sha1sum": {
          "$ref": "#/definitions/sha1"
        },
        "openid": {
          "$ref": "#/definitions/iri"
        },
        "account": {
          "$ref": "#/definitions/account"
        }
      }
    },
    "group": {
      "type": "object",
      "required": ["objectType"],
      "additionalProperties": false,
      "properties": {
        "objectType": {
          "const": "Group"
        },
        "name": {
          "type": "string"
        },
        "member": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/agent"
          }
        },
        "mbox": {
          "$ref": "#/definitions/mbox"
        },
        "mbox_sha1sum": {
          "$ref": "#/definitions/sha1"
        },
        "openid": {
          "$ref": "#/definitions/iri"
        },
        "account": {
          "$ref": "#/definitions/account"
        }
      }
    },
    "actor": {
      "if": {
        "required": ["objectType"],
        "properties": {
          "objectType": {
            "const": "Group"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/group"
      },
      "else": {
        "$ref": "#/definitions/agent"
      }
    },
    "verb": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/iri"
        },
        "display": {
          "$ref": "#/definitions/languageMap"
        }
      }
    },
    "interactionComponent": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "\\[[,.]\\]"
          }
        },
        "description": {
          "$ref": "#/definitions/languageMap"
        }
      }
    },
    "componentList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/interactionComponent"
      }
    },
    "activityDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/languageMap"
        },
        "description": {
          "$ref": "#/definitions/languageMap"
        },
        "type": {
          "$ref": "#/definitions/iri"
        },
        "moreInfo": {
          "$ref": "#/definitions/iri"
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        },
        "interactionType": {
          "enum": [
            "true-false",
            "choice",
            "fill-in",
            "long-fill-in",
            "matching",
            "performance",
            "sequencing",
            "likert",
            "numeric",
            "other"
          ]
        },
        "correctResponsesPattern": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choices": {
          "$ref": "#/definitions/componentList"
        },
        "scale": {
          "$ref": "#/definitions/componentList"
        },
        "source": {
          "$ref": "#/definitions/componentList"
        },
        "target": {
          "$ref": "#/definitions/componentList"
        },
        "steps": {
          "$ref": "#/definitions/componentList"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": ["correctResponsesPattern"]
              },
              {
                "required": ["choices"]
              },
              {
                "required": ["scale"]
              },
              {
                "required": ["source"]
              },
              {
                "required": ["target"]
              },
              {
                "required": ["steps"]
              }
            ]
          },
          "then": {
            "required": ["interactionType"]
          }
        },
        {
          "if": {
            "required": ["interactionType"],
            "properties": {
              "interactionType": {
                "enum": ["choice", "sequencing"]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["scale"]
                },
                {
                  "required": ["source"]
                },
                {
                  "required": ["target"]
                },
                {
                  "required": ["steps"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["interactionType"],
            "properties": {
              "interactionType": {
                "enum": [
                  "true-false",
                  "fill-in",
                  "long-fill-in",
                  "numeric",
                  "other"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["choices"]
                },
                {
                  "required": ["scale"]
                },
                {
                  "required": ["source"]
                },
                {
                  "required": ["target"]
                },
                {
                  "required": ["steps"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["interactionType"],
            "properties": {
              "interactionType": {
                "const": "likert"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["choices"]
                },
                {
                  "required": ["source"]
                },
                {
                  "required": ["target"]
                },
                {
                  "required": ["steps"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["interactionType"],
            "properties": {
              "interactionType": {
                "const": "matching"
              }
            }
          },
          "then": {
            "required": ["source", "target"],
            "not": {
              "anyOf": [
                {
                  "required": ["choices"]
                },
                {
                  "required": ["scale"]
                },
                {
                  "required": ["steps"]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": ["interactionType"],
            "properties": {
              "interactionType": {
                "const": "performance"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["choices"]
                },
                {
                  "required": ["scale"]
                },
                {
                  "required": ["source"]
                },
                {
                  "required": ["target"]
                }
              ]
            }
          }
        }
      ]
    },
    "activity": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "objectType": {
          "const": "Activity"
        },
        "id": {
          "$ref": "#/definitions/iri"
        },
        "definition": {
          "$ref": "#/definitions/activityDefinition"
        }
      }
    },
    "statementRef": {
      "type": "object",
      "required": ["objectType", "id"],
      "additionalProperties": false,
      "properties": {
        "objectType": {
          "const": "StatementRef"
        },
        "id": {
          "$ref": "#/definitions/uuid"
        }
      }
    },
    "object": {
      "description": "Activity (objectType absent or Activity), Agent, Group or StatementRef; SubStatement is not used by HAX and is not covered",
      "if": {
        "required": ["objectType"],
        "properties": {
          "objectType": {
            "const": "Agent"
          }
        }
      },
      "then": {
        "$ref": "#/definitions/agent"
      },
      "else": {
        "if": {
          "required": ["objectType"],
          "properties": {
            "objectType": {
              "const": "Group"
            }
          }
        },
        "then": {
          "$ref": "#/definitions/group"
        },
        "else": {
          "if": {
            "required": ["objectType"],
            "properties": {
              "objectType": {
                "const": "StatementRef"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/statementRef"
          },
          "else": {
            "$ref": "#/definitions/activity"
          }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scaled": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "raw": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "$ref": "#/definitions/score"
        },
        "success": {
          "type": "boolean"
        },
        "completion": {
          "type": "boolean"
        },
        "response": {
          "type": "string"
        },
        "duration": {
          "$ref": "#/definitions/duration"
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      }
    },
    "contextActivityList": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/activity"
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registration": {
          "$ref": "#/definitions/uuid"
        },
        "instructor": {
          "$ref": "#/definitions/actor"
        },
        "team": {
          "$ref": "#/definitions/group"
        },
        "contextActivities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parent": {
              "$ref": "#/definitions/contextActivityList"
            },
            "grouping": {
              "$ref": "#/definitions/contextActivityList"
            },
            "category": {
              "$ref": "#/definitions/contextActivityList"
            },
            "other": {
              "$ref": "#/definitions/contextActivityList"
            }
          }
        },
        "revision": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        },
        "language": {
          "$ref": "#/definitions/languageTag"
        },
        "statement": {
          "$ref": "#/definitions/statementRef"
        },
        "extensions": {
          "$ref": "#/definitions/extensions"
        }
      }
    },
    "attachment": {
      "type": "object",
      "required": ["usageType", "display", "contentType", "length", "sha2"],
      "additionalProperties": false,
      "properties": {
        "usageType": {
          "$ref": "#/definitions/iri"
        },
        "display": {
          "$ref": "#/definitions/languageMap"
        },
        "description": {
          "$ref": "#/definitions/languageMap"
        },
        "contentType": {
          "type": "string"
        },
        "length": {
          "type": "integer",
          "minimum": 0
        },
        "sha2": {
          "type": "string"
        },
        "fileUrl": {
          "$ref": "#/definitions/iri"
        }
      }
    }
  }
}
