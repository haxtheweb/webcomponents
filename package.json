  "lint-staged": {
    "*.js": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.json": "prettier --write",
    "*.{png,jpeg,jpg,gif,svg}": "node scripts/optimize-staged-images.js",
    "*.css": "stylelint --fix"
  },
  "keywords": [
    "webcomponents",
    "html",
    "haxtheweb",
    "lit"
  ],
  "private": true,
  "npmClient": "yarn",
  "useWorkspaces": true,
  "workspaces": {
    "packages": [
      "elements/*"
    ],
    "nohoist": []
  }
