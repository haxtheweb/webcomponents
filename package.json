{
  "name": "@haxtheweb/webcomponents",
  "version": "26.8.1",
  "description": "HAXTheWeb web component library",
  "orgNpm": "@haxtheweb",
  "monorepo": "webcomponents",
  "engines": {
    "node": "24.x"
  },
  "wcfactory": {
    "askSASS": false,
    "askProps": false,
    "askHAX": false,
    "monorepo": "webcomponents",
    "orgNpm": "@haxtheweb",
    "orgGit": "haxtheweb",
    "gitRepo": "https://github.com/haxtheweb/webcomponents.git",
    "sass": {
      "name": "rh-sass",
      "pkg": "@rhelements/rh-sass",
      "path": "rh-sass/rh-sass"
    },
    "license": "Apache-2.0"
  },
  "author": {
    "name": "haxtheweb",
    "url": "https://hax.psu.edu/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/haxtheweb/webcomponents.git"
  },
  "scripts": {
    "prepare": "husky install",
    "start": "yarn run haxsite",
    "lerna": "lerna",
    "devhax": "yarn run haxsite",
    "haxsite": "cd elements/haxcms-elements && yarn start",
    "apphax": "cd elements/app-hax && yarn start",
    "preinstall": "node scripts/preinstall.js",
    "postinstall": "node scripts/postinstall.js && ./node_modules/.bin/patch-package",
    "init": "lerna init",
    "format": "run-s format:*",
    "format:js": "prettier --write **/*.{js,json}",
    "format:css": "stylelint --fix **/*.css",
    "format:check": "prettier --check **/*.{js,json}",
    "lint": "eslint elements",
    "lint:fix": "eslint elements --fix",
    "lint:ddd-tokens": "node scripts/ddd-token-lint.js",
    "precheck": "node scripts/precheck.mjs",
    "precheck:fix": "node scripts/precheck.mjs --fix",
    "tokens:ddd": "node elements/d-d-d/design-system/build-tokens.js",
    "design-system:sync": "node elements/d-d-d/design-system/sync.js",
    "test": "lerna run test --concurrency=1",
    "test:all": "web-test-runner \"elements/*/test/*.test.js\" --node-resolve --root-dir . --playwright --browsers chromium --static-logging",
    "build": "lerna run build && yarn run build-gallery",
    "publish": "echo 'NOTICE: You must run `lerna publish` manually'",
    "gallery": "yarn run build-gallery && npx @web/dev-server --open index.html --root-dir .",
    "gallery:dev": "node scripts/gallery-dev-server.js",
    "build-gallery": "node scripts/build-component-gallery.js",
    "prepare-vercel": "node scripts/prepare-vercel-deploy.js",
    "storybook": "echo 'Storybook has been replaced with the component gallery. Use: yarn gallery' && exit 1",
    "build-storybook": "echo 'Storybook has been replaced with the component gallery. Use: yarn build-gallery' && exit 1",
    "rebuild-wcfcache": "./node_modules/.bin/gulp",
    "haxschema": "./node_modules/.bin/gulp haxschema",
    "new": "hax",
    "ubiquity": "polymer build && yarn run vendor-copy-xterm && yarn run vendor-copy-latex2html5 && yarn run terser && yarn run wc-autoloader && yarn run theme-discovery && yarn run language-registry-sync && yarn run hax-elements-discovery && yarn run elements-catalog && yarn run hax-elements-demo-page && yarn run elements-readme && yarn run translation-manifest && yarn run language-registry-report && yarn run version-match && mkdir build/es6/node_modules/@lrnwebcomponents && cp -R build/es6/node_modules/@haxtheweb/wc-autoload build/es6/node_modules/@lrnwebcomponents/wc-autoload && cp -R build/es6/node_modules/@haxtheweb/dynamic-import-registry build/es6/node_modules/@lrnwebcomponents/dynamic-import-registry && yarn run license-restore",
    "ubiquity-build": "bash scripts/ubiquity-testing.sh",
    "ubiquity-publish": "bash scripts/ubiquity-push.sh",
    "terser": "gulp terser --gulpfile=gulpfile.mjs",
    "vendor-copy-xterm": "gulp vendor-copy-xterm --gulpfile=gulpfile.mjs",
    "vendor-copy-latex2html5": "gulp vendor-copy-latex2html5 --gulpfile=gulpfile.mjs",
    "wc-autoloader": "gulp wc-autoloader --gulpfile=gulpfile.mjs",
    "theme-discovery": "gulp theme-discovery --gulpfile=gulpfile.mjs",
    "theme-screenshots": "gulp theme-screenshots --gulpfile=gulpfile.mjs",
    "hax-elements-discovery": "gulp hax-elements-discovery --gulpfile=gulpfile.mjs",
    "elements-catalog": "node scripts/build-elements-catalog.mjs",
    "hax-elements-demo-page": "gulp hax-elements-demo-page --gulpfile=gulpfile.mjs",
    "elements-readme": "node scripts/generate-elements-readme.js",
    "translation-manifest": "node scripts/generate-translation-manifest.js",
    "language-registry-report": "node scripts/validate-language-registry.js",
    "language-registry-sync": "node scripts/sync-language-registry.js",
    "version-match": "gulp version-match --gulpfile=gulpfile.mjs",
    "license-restore": "node scripts/copy-dep-licenses.js",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@lit-labs/virtualizer": "2.1.1",
    "@lit/reactive-element": "2.1.2",
