    "commit-and-tag-version": "12.7.3",
    "decomment": "0.9.5",
    "deepmerge": "4.3.1",
    "del": "6.0.0",
    "esbuild": "^0.25.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-wc": "3.1.0",
    "global": "4.4.0",
